{
  "name": "aktionskalender-fachhandel",
  "private": true,
  "description": "Aktionskalender für den Fachhandel (elektrabregenz, Beko, Indesit) – Cloudflare Pages",
  "scripts": {
    "dev": "wrangler pages dev public --kv KALENDER",
